        "exits": {"back": "bedroom"}
    },
    "kitchen": {
        "description": "You are in the kitchen.",
        "items": ["knife"],
        "exits": {"left": "main room"}
    },
    "apartment building hallway": {
        "description": "You are in the apartment building's hallway.",
        "items": [],
        "exits": {"right": "main room"}
    }
}

currentRoom = "bedroom"

showInstructions()

while True:
    status()
    move = input("What will you do? >")
    move = move.split(" ", 1)

    if move[0] == "get":
        if move[1] in rooms[currentRoom]["items"]:
            print(f"You picked up the {move[1]}.")
            inventory.append(move[1])
            rooms[currentRoom]["items"].remove(move[1])
        else:
            print(f"You already took the {move[1]}.")
    elif move[0] == "go":
        if move[1] in rooms[currentRoom]["exits"]:
            currentRoom = rooms[currentRoom]["exits"][move[1]]
            print(f"You walk to the {currentRoom}.")
        else:
            print("You can't go that way.")



    