import random
import time

def slow_print(text, delay=0.02):
    for char in text:
        print(char, end="", flush=True)
        time.sleep(delay)
    print()

def showInstructions( ):
    print("====================================")
    slow_print("There are a few commands you can use to interact with the game.")
    slow_print("Commands are case sensitive, and must be typed exactly as shown.")
    slow_print("Be wary.")
    print("====================================")
    slow_print("Action: go [direction]")
    slow_print("        get [item]")
    slow_print("        attack, heal, run")
    slow_print("        look, inventory, quit")

def show_health():
    health_width = 20
    filled = int(player_health / player_max_health * health_width)
    bar = "#" * filled + "-" * (health_width - filled)
    print(f"Health: [{bar}] {player_health}/{player_max_health}")

def death_screen():
    print("\n====================================")
    print("              YOU DIED")
    print("====================================")
    print("You Idiot...")

def fight(enemy_name, enemy_health, enemy_max_health, enemy_attack):
    global player_health

    print(f"\nA {enemy_name} blocks your path!")
    while enemy_health > 0 and player_health > 0:
        print("------------------------------------")
        show_health()
        enemy_bar = "#" * int(enemy_health / enemy_max_health * 20)
        enemy_bar += "-" * (20 - len(enemy_bar))
        print(f"{enemy_name.title()}: [{enemy_bar}] {enemy_health}/{enemy_max_health}")
        action = input("Fight> ").lower().strip()

        if action == "attack":
            damage = random.randint(12, 20) if "knife" in inventory else random.randint(4, 8)
            enemy_health = max(0, enemy_health - damage)
            print(f"You hit the {enemy_name} for {damage} damage.")
        elif action == "heal":
            if "bandages" not in inventory:
                print("You do not have any bandages.")
                continue
            if player_health == player_max_health:
                print("You are already at full health.")
                continue
            player_health = min(player_max_health, player_health + 25)
            inventory.remove("bandages")
            print("You use the bandages and recover 25 health.")
        elif action == "run":
            print("You retreat to the main room.")
            return False
        else:
            print("Choose attack, heal, or run.")
            continue

        if enemy_health > 0:
            damage = random.randint(enemy_attack - 2, enemy_attack + 2)
            player_health = max(0, player_health - damage)
            print(f"The {enemy_name} hits you for {damage} damage.")

    if player_health <= 0:
        death_screen()
        return False

    print(f"You defeated the {enemy_name}.")
    return True
    
def show_room():
    print("--------------------")
    slow_print(f"You are in the {currentRoom}.")
    print("--------------------")
    print(f"{rooms[currentRoom]['description']}")
    print("--------------------")
    room_items = rooms[currentRoom]["items"]
    if room_items:
        print(f"You can see the following items: {', '.join(room_items)}. Take them?")

def status():
    print("--------------------")
    show_health()
    slow_print(f"Inventory: {inventory}")
    print("--------------------")
              
