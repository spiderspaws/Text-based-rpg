    move = input("What will you do? >")
    move = move.lower().split()

    if not move:
        print("Please enter a command. Type 'help' to see the available commands.")
        continue

    command = move[0]

    if command == "get":
        if len(move) < 2:
            print("Get what?")
            continue
        item = " ".join(move[1:])
        if item in rooms[currentRoom]["items"]:
            print(f"You picked up the {item}.")
            inventory.append(item)
            rooms[currentRoom]["items"].remove(item)
        else:
            print(f"There is no {item} here.")
    elif command == "go":
        if len(move) < 2:
            print("Go where?")
            continue
        direction = " ".join(move[1:])
        if direction in rooms[currentRoom]["exits"]:
            currentRoom = rooms[currentRoom]["exits"][direction]
            print(f"You walk to the {currentRoom}.")
